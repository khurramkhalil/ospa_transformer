#!/bin/bash
#SBATCH --partition=rss-gpu
#SBATCH -N 1
#SBATCH -c 60
#SBATCH --mem 0G
#SBATCH --gres=gpu:A100:1
#SBATCH --export=all
#SBATCH --out=OSPA_Final_Analysis-%j.out
#SBATCH --output=ospa_final.%J_stdout.txt
#SBATCH --error=ospa_final.%J_stderr.txt
#SBATCH --time=24:00:00
#SBATCH --job-name=OSPA_Final
#SBATCH --mail-user=khurram.khalil@missouri.edu
#SBATCH --mail-type=ALL

# Load required modules
module load miniconda3/4.10.3_gcc_9.5.0
source activate deepseek

echo "Starting OSPA final analysis job at $(date)"
echo "Running on host: $(hostname)"
echo "CUDA devices: $CUDA_VISIBLE_DEVICES"
echo "SLURM Job ID: $SLURM_JOB_ID"

# Create all required directories in advance
echo "Creating all required directories..."
mkdir -p outputs
mkdir -p outputs/vanilla_model
mkdir -p outputs/ospa_model
mkdir -p outputs/analysis

# Check existing files and directories
echo "Current output directories:"
ls -la outputs/

# Step 1: Train vanilla model with explicit output directory
echo "=========================="
echo "Training vanilla model..."
echo "=========================="
python train_ospa.py \
    --task lm \
    --transformer_type vanilla \
    --orth_mode init \
    --d_model 256 --nhead 4 --nlayers 3 \
    --dim_feedforward 1024 \
    --epochs 5 \
    --batch_size 32 \
    --lr 5e-4 \
    --weight_decay 0.01 \
    --clip 0.25 \
    --bptt 35 \
    --vocab_cutoff 10000 \
    --log_interval 50 \
    --output_dir outputs/vanilla_model \
    --save model.pt \
    --seed 42

# Check if vanilla model was created
if [ -f "outputs/vanilla_model/model.pt" ]; then
    echo "✓ Vanilla model training completed successfully"
else
    echo "✗ ERROR: Vanilla model training failed"
    # Continue anyway to try OSPA model
fi

# Step 2: Train OSPA model with explicit output directory
echo "=========================="
echo "Training OSPA model..."
echo "=========================="
python train_ospa.py \
    --task lm \
    --transformer_type ospa \
    --orth_mode regularize \
    --orth_penalty_weight 0.001 \
    --d_model 256 --nhead 4 --nlayers 3 \
    --dim_feedforward 1024 \
    --epochs 5 \
    --batch_size 32 \
    --lr 5e-4 \
    --weight_decay 0.01 \
    --clip 0.25 \
    --bptt 35 \
    --vocab_cutoff 10000 \
    --log_interval 50 \
    --output_dir outputs/ospa_model \
    --save model.pt \
    --seed 42

# Check if OSPA model was created
if [ -f "outputs/ospa_model/model.pt" ]; then
    echo "✓ OSPA model training completed successfully"
else
    echo "✗ ERROR: OSPA model training failed"
    # Continue anyway to try analysis on whatever models we have
fi

# Step 3: List all available models for analysis
echo "=========================="
echo "Available models for analysis:"
echo "=========================="
find outputs/ -name "*.pt" -type f

# Step 4: Run analysis on individual models 
echo "=========================="
echo "Running individual model analyses..."
echo "=========================="

# Function to analyze a model if it exists
analyze_model() {
    model_path=$1
    model_name=$2
    
    if [ -f "$model_path" ]; then
        echo "Analyzing model: $model_name"
        
        # Make output directory
        mkdir -p "outputs/analysis/$model_name"
        
        # Run analysis
        python analyze_head_diversity.py \
            --model_path "$model_path" \
            --output_dir "outputs/analysis/$model_name" \
            --d_model 256 --nhead 4 --nlayers 3 \
            --dim_feedforward 1024 \
            --task lm \
            --prefix "$model_name" \
            --device cpu
            
        if [ $? -eq 0 ]; then
            echo "✓ Analysis completed for $model_name"
        else
            echo "✗ Analysis failed for $model_name"
        fi
    else
        echo "✗ Model not found: $model_path"
    fi
}

# Analyze vanilla model
analyze_model "outputs/vanilla_model/model.pt" "vanilla"

# Analyze OSPA model
analyze_model "outputs/ospa_model/model.pt" "ospa"

# Also try to analyze our original best_model if it exists
analyze_model "outputs/best_model.pt" "best_model"

# Step 5: Compare models if we have at least two
echo "=========================="
echo "Running model comparison if possible..."
echo "=========================="

# Get list of available models
available_models=$(find outputs/ -name "*.pt" -type f)
model_count=$(echo "$available_models" | wc -l)

if [ "$model_count" -ge 2 ]; then
    echo "Found $model_count models. Running comparison."
    
    # Convert newline-separated list to space-separated for command line
    model_paths=$(echo "$available_models" | tr '\n' ' ')
    
    # Create comparison directory
    mkdir -p outputs/analysis/comparison
    
    # Run comparison
    python analyze_head_diversity.py --compare \
        --model_paths $model_paths \
        --output_dir outputs/analysis/comparison \
        --d_model 256 --nhead 4 --nlayers 3 \
        --dim_feedforward 1024 \
        --task lm \
        --device cpu
        
    if [ $? -eq 0 ]; then
        echo "✓ Model comparison completed successfully"
    else
        echo "✗ Model comparison failed"
    fi
else
    echo "Not enough models for comparison (found $model_count, need at least 2)"
fi

# Step 6: Check final output
echo "=========================="
echo "Final analysis outputs:"
echo "=========================="
find outputs/analysis -type f | sort

echo "Job completed at $(date)"